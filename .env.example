# Feedback button: creates issues in DMI-ecosystem-nl/ruimtemodel-stadslogistiek.
# Preferred: the organisation's GitHub App (permission "Issues: Read and write",
# installed on this repository). It does not expire.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# The App's .pem private key, base64-encoded on one line: base64 -i key.pem
GITHUB_APP_PRIVATE_KEY=

# Alternative: fine-grained personal access token with "Issues: Read and write" on this repository.
# GITHUB_FEEDBACK_TOKEN=

# Optional: "owner/name" of another repository.
# GITHUB_FEEDBACK_REPO=
